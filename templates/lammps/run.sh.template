#!/bin/bash
set -e

# LAMMPS MD execution script
# Uses input.lammps generated by _make_template

cd "$(dirname "$0")"

INPUT="${INPUT:-input.lammps}"
NP="${NP:-1}"

if [ "$NP" -gt 1 ] && command -v mpirun &>/dev/null; then
    mpirun -np "$NP" lmp -i "$INPUT"
elif command -v lmp &>/dev/null; then
    lmp -i "$INPUT"
elif command -v lmp_mpi &>/dev/null; then
    mpirun -np "$NP" lmp_mpi -i "$INPUT"
elif command -v lmp_serial &>/dev/null; then
    lmp_serial -i "$INPUT"
else
    echo "ERROR: LAMMPS executable not found (lmp/lmp_mpi/lmp_serial)"
    exit 1
fi

echo "[DONE] LAMMPS simulation finished in $PWD"
